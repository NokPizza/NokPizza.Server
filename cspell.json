{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words", "csharp", "softwareTerms"],
  "ignorePaths": [
    ".editorconfig",
    "project-words.txt",
    "**/Migrations/**",
    "**/*.csproj",
    "bin",
    "obj",
    ".gitignore",
    ".vs",
    ".vscode",
    "workspace.json"
  ]
}
